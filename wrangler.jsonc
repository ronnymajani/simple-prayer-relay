{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simple-prayer-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	// Required by @sentry/cloudflare.
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Workers Logs off. This is not a performance setting — it is the "no logs" claim in the privacy
	// policy. Turning it on would record every request this relay serves, with its URL and timing,
	// which is exactly the record the feature promises does not exist. Logpush is likewise never
	// configured. Cloudflare's own aggregate edge analytics remain, and hold nothing per-caller.
	"observability": {
		"enabled": false
	},
	"d1_databases": [
		{
			// `DB` is the name every statement in src/db.ts reaches for (`env.DB`). `wrangler d1 create`
			// appends a binding of its own named after the database rather than filling this one in —
			// delete that one and keep the id here, or the Worker deploys with a binding nothing uses
			// and a `DB` that points nowhere.
			"binding": "DB",
			"database_name": "simple-prayer-relay",
			// Not a secret — an account-scoped handle, useless without credentials — so it lives in the
			// public repo.
			"database_id": "335289df-2a76-40f5-b4f2-48fd18ba87d9",
			"migrations_dir": "migrations"
		}
	],
	// Burst protection at the edge. The windows longer than a minute (per-day quotas, the ten-minute
	// pairing window) live in the `quota` table, because this binding only accepts 10 or 60 seconds.
	"ratelimits": [
		{
			"name": "BURST_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			// Redeeming a code is the one endpoint worth guessing at, so it gets its own, tighter bucket.
			"name": "PAIR_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	// Hourly sweep: expire inbox rows, invites and quota counters, and retire devices and pairs that
	// have been silent for 90 days.
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"routes": [
		{
			"pattern": "relay.simpleprayer.app",
			"custom_domain": true
		}
	]
	// Secrets — set with `wrangler secret put`, never written here:
	//   TOKEN_KEY          32 random bytes, base64. Encrypts push tokens at rest.
	//   IP_SECRET          Keys the HMAC that stands in for an IP address in the quota table.
	//   EXPO_ACCESS_TOKEN  Lets the relay send through Expo with enhanced push security on.
	//   SENTRY_DSN         Optional. Absent means no Sentry at all.
}
