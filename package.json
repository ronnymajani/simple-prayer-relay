{
  "name": "simple-prayer-relay",
  "version": "1.0.0",
  "description": "The buddy relay for Simple Prayer: forwards one anonymous flag between two paired phones and keeps nothing.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply simple-prayer-relay --local",
    "db:remote": "wrangler d1 migrations apply simple-prayer-relay --remote"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.74.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.2"
  }
}
